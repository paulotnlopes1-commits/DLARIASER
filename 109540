local function updateHomeInfo()
    local player = game:GetService("Players").LocalPlayer
    local placeId = game.PlaceId
    local placeName = "Desconhecido"
    local regionCode = game:GetService("PhysicsService"):GetServerRegion()
    local playerCount = #game:GetService("Players"):GetPlayers()
    
    local success, result = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(placeId).Name
    end)
    if success and result then
        placeName = result
    end
    
    if LMG2L["12_1b"] then LMG2L["12_1b"].Text = "User : " .. player.Name end
    if LMG2L["13_1a"] then LMG2L["13_1a"].Text = "tempo : " .. os.date("%H:%M:%S") end
