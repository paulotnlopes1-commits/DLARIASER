    if LMG2L["16_1c"] then LMG2L["16_1c"].Text = "Região : " .. regionCode end
    if LMG2L["17_1d"] then LMG2L["17_1d"].Text = "Jogadores : " .. playerCount .. "/" .. game:GetService("Players").MaxPlayers end
end

