	-- SISTEMA DA ABA HOME (DADOS EM TEMPO REAL)
	local ImgPerfil = LMG2L["perfilownerplayer_a"]
	local LblUser = LMG2L["12_e"]
	local LblTime = LMG2L["13_d"]
	local LblId = LMG2L["14_c"]
	local LblPlace = LMG2L["15_b"]

	-- Torna o fundo do frame da imagem invisível e carrega a Headshot oficial do jogador
	ImgPerfil.BackgroundTransparency = 1
	ImgPerfil.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=420&height=420&format=png"

	-- Aplica o nome de usuário e o ID do Place correspondente
	LblUser.Text = "User: " .. LocalPlayer.Name
	LblId.Text = "Place ID: " .. tostring(game.PlaceId)

	-- Busca segura das informações do produto para obter o nome real do mapa
	local success, gameData = pcall(function()
		return MarketplaceService:GetProductInfo(game.PlaceId)
	end)
	if success and gameData then
		LblPlace.Text = "Place name: " .. tostring(gameData.Name)
	else
		LblPlace.Text = "Place name: " .. tostring(game.Name)
	end

	-- Thread de atualização do relógio local (formato HH:MM:SS) a cada 1 segundo
	task.spawn(function()
		while task.wait(1) do
			if LblTime then
				LblTime.Text = "Time: " .. os.date("%H:%M:%S")
			end
		end
	end)

	-- SISTEMA DE OPERAÇÕES DO EXECUTOR
	local CodeBox = LMG2L["script_14"]
	local ExeBtn = LMG2L["exe_15"]
	local ClearBtn = LMG2L["cle_16"]

	-- Evento do botão Clear: redefine o texto da TextBox para vazio
	ClearBtn.MouseButton1Click:Connect(function()
		CodeBox.Text = ""
	end)

	-- Evento do botão Exe: compilação e execução dinâmica de código (suporte a exploits)
	ExeBtn.MouseButton1Click:Connect(function()
		local scriptSource = CodeBox.Text
		if scriptSource and scriptSource ~= "" then
			local closure, syntaxError = loadstring(scriptSource)
			if closure then
				task.spawn(closure)
			else
				warn("[Erro do Executor]: " .. tostring(syntaxError))
			end
		end
	end)

	-- MECANISMO DE ARRASTAR A GUI PRINCIPAL (DRAGGABLE)
	local isDragging = false
	local currentDragInput, initialTouchPos, initialFramePos

	MainFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
			initialTouchPos = input.Position
			initialFramePos = MainFrame.Position
			
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					isDragging = false
				end
			end)
		end
	end)

	MainFrame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			currentDragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == currentDragInput and isDragging then
			local offset = input.Position - initialTouchPos
			MainFrame.Position = UDim2.new(
				initialFramePos.X.Scale, 
				initialFramePos.X.Offset + offset.X, 
				initialFramePos.Y.Scale, 
				initialFramePos.Y.Offset + offset.Y
			)
		end
	end)
end)


return LMG2L["ScreenGui_1"], require;
